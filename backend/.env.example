# Configuración local del servidor. Copia este archivo como .env y cambia los valores.
# El archivo .env no se sube a git (está en .gitignore).

# Clave secreta de Django: genera una propia con
#   ..\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave

# True solo en desarrollo: muestra errores detallados y sirve los archivos estáticos.
DEBUG=True

# Nombres o IP desde los que se puede abrir el servidor, separados por coma.
# Para que el ESP32 llegue al PC, añade la IP del PC en la red local (ej. 192.168.1.50).
ALLOWED_HOSTS=127.0.0.1,localhost

# Ruta del archivo SQLite, relativa a la carpeta backend/.
DB_PATH=db.sqlite3

# Clave compartida con el ESP32. Si tiene valor, /api/eventos/ y /api/comandos/
# exigen la cabecera  X-Token: <valor>. Vacía = sin clave (solo para pruebas locales).
API_TOKEN=
